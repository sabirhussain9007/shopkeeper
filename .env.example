# ---------------------------------------------------------------------------
# Shopkeeper — environment template
#
# Copy to `.env` (or `.env.local`) and fill in real values:
#   cp .env.example .env
#
# `.env*` is gitignored except this template. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------

# MongoDB connection string. Required — lib/db.ts throws without it.
MONGODB_URI=mongodb://127.0.0.1:27017/shopkeeper

# Public origin of this deployment, no trailing slash.
# Used for canonical tags, robots.txt, sitemap.xml, OG images and payment
# gateway return URLs. A production build FAILS if none of
# NEXT_PUBLIC_APP_URL / APP_URL / NEXTAUTH_URL is set (see lib/site.ts).
# Production: https://shopkeeper-app.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth callback origin. Keep in sync with NEXT_PUBLIC_APP_URL.
# Production: https://shopkeeper-app.netlify.app
NEXTAUTH_URL=http://localhost:3000

# JWT/cookie signing secret. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-me-with-a-32-byte-random-secret

# Minutes of inactivity before the client signs the user out.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30

# --- Platform payment accounts (subscription payments) ----------------------
# All five are validated together by lib/payment-env.ts; the manual checkout
# flow is disabled with an explicit error until every one of them is valid.

# Mobile number (03XX-XXXXXXX) or merchant ID (5–20 digits).
PAYMENT_EASYPAISA=03001234567
PAYMENT_JAZZCASH=03001234567

# Bank name, account title, and 10–24 digit account number.
PAYMENT_BANK_NAME=Meezan Bank
PAYMENT_BANK_TITLE=Shopkeeper Pvt Ltd
PAYMENT_BANK_ACCOUNT=01234567890123

# --- Payment gateways (all optional; each is skipped when unset) ------------

# Stripe — card checkout is offered only when STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EasyPaisa — gateway checkout needs both STORE_ID and HASH_KEY.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_SANDBOX=true
# Overrides the sandbox/live endpoint chosen from EASYPAISA_SANDBOX.
EASYPAISA_CHECKOUT_URL=

# JazzCash — gateway checkout needs MERCHANT_ID, PASSWORD and INTEGRITY_SALT.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
# Overrides the sandbox/live endpoint chosen from JAZZCASH_SANDBOX.
JAZZCASH_GATEWAY_URL=

# --- Email -----------------------------------------------------------------
# Without EMAIL_WEBHOOK_URL, mail is logged to the console in development
# and silently dropped in production.
EMAIL_WEBHOOK_URL=
EMAIL_FROM=noreply@shopkeeper.local

# --- Seed defaults (npm run seed) ------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@shop.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME=System Administrator

SUPER_ADMIN_EMAIL=superadmin@shop.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Platform Super Admin

DEFAULT_APP_NAME=Shopkeeper
DEFAULT_APP_TAGLINE=Retail Command
DEFAULT_DASHBOARD_TITLE=Enterprise Retail Management
DEFAULT_BUSINESS_NAME=Shopkeeper

# Re-hash DEFAULT_ADMIN_PASSWORD onto the existing admin.
SEED_RESET_ADMIN_PASSWORD=false
# Replace existing business settings with the seed defaults.
SEED_OVERWRITE_SETTINGS=false
